// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id              Int      @id @default(autoincrement())
  type            String   // "subscribe", "executed", "payment_transfer_failure", "cancel"
  subscriber      String
  merchant        String
  token           String
  amount          String   // Store as string to handle big integers
  ledgerTimestamp BigInt
  createdAt       DateTime @default(now())
}

model AuditLog {
  id               Int      @id @default(autoincrement())
  eventType        String
  subscriber       String
  merchant         String
  token            String
  amount           String
  transactionHash  String   @unique
  ledger           BigInt
  status           String   @default("executed")
  createdAt        DateTime @default(now())
}

model PayoutSummary {
  id           Int      @id @default(autoincrement())
  merchant     String
  startDate    DateTime
  endDate      DateTime
  totalAmount  String   // Total amount for the period
  paymentCount Int      // Number of payments
  currency     String   // Token address
  createdAt    DateTime @default(now())
  type         String   // "daily" or "weekly"
}

model WebhookEndpoint {
  id        Int      @id @default(autoincrement())
  merchant  String
  url       String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([merchant, url])
}

model WebhookDelivery {
  id         Int      @id @default(autoincrement())
  url        String
  merchant   String
  event      String
  payload    String
  statusCode Int
  attempt    Int
  success    Boolean
  error      String?
  createdAt  DateTime @default(now())
}

// BE-67: Subscription lifecycle state machine persistence
model Subscription {
  id         Int      @id @default(autoincrement())
  subscriber String
  merchant   String
  token      String   @default("")
  status     String   @default("ACTIVE") // ACTIVE | PAUSED | OVERDUE | CANCELLED | EXPIRED
  amount     String   @default("0")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([subscriber, merchant], name: "subscriber_merchant")
}

// BE-68: Email notification preferences
model NotificationPreference {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  subscriber   String?
  merchant     String?
  unsubToken   String   @unique @default(cuid())
  emailEnabled Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Issue #742: KYC/AML verification records
model KycVerification {
  id                 Int       @id @default(autoincrement())
  // User's Stellar wallet address
  walletAddress      String    @unique
  // Status: pending | submitted | approved | rejected | expired | re_verification_required
  status             String    @default("pending")
  // KYC provider (onfido | jumio)
  provider           String
  // Provider's unique applicant/verification ID
  providerApplicantId String?  @unique
  // Verification workflow run ID (provider-specific)
  providerWorkflowRunId String?
  // Document type provided: passport | national_id | driving_license
  documentType       String?
  // Whether liveness detection was completed
  livenessCompleted  Boolean   @default(false)
  // AML screening status: pending | clear | consider | flagged
  amlStatus          String    @default("pending")
  // AML screening report/check ID from provider
  amlCheckId         String?
  // ISO 3166-1 alpha-3 country code from document
  countryCode        String?
  // Risk score from AML check (0-100)
  riskScore          Int?
  // Webhook events log (JSON array of raw webhook payloads)
  webhookLog         String    @default("[]")
  // Timestamps
  submittedAt        DateTime?
  approvedAt         DateTime?
  rejectedAt         DateTime?
  expiresAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status])
  @@index([amlStatus])
}

// Issue #742: KYC/AML audit trail
model KycAuditLog {
  id            Int      @id @default(autoincrement())
  walletAddress String
  action        String   // initiated | document_submitted | liveness_completed | aml_screened | approved | rejected | re_verification_triggered | webhook_received
  actor         String   // system | user | webhook | admin
  details       String   @default("{}")  // JSON string with action-specific details
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([walletAddress])
  @@index([createdAt])
}
